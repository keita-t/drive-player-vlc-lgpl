     int64_t     i_current_pts;
+    /* How far the timestamps read run ahead of the stream's clock: a muxer
+     * writes each picture ahead of its time, by as much as the decoder buffers */
+    vlc_tick_t  i_scr_lead;
     uint64_t    i_start_byte;
     uint64_t    i_lastpack_byte;
 
@@ -214,6 +217,7 @@ static int OpenCommon( vlc_object_t *p_this, bool b_force )
     p_sys->i_scr_track_id = 0;
     p_sys->i_length   = i_length;
     p_sys->i_current_pts = (vlc_tick_t) 0;
+    p_sys->i_scr_lead = 0;
