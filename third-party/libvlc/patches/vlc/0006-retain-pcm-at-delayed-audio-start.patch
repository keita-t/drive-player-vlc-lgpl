index 67a9cf2..571394d 100644
--- a/src/input/clock.h
+++ b/src/input/clock.h
@@ -31,7 +31,8 @@
 /** @struct input_clock_t
  * This structure is used to manage clock drift and reception jitters
  *
- * XXX input_clock_GetTS can be called from any threads. All others functions
+ * XXX input_clock_ConvertTS and input_clock_DelayStart can be called from any
+ * thread. All other functions
  * MUST be called from one and only one thread.
  */
 typedef struct input_clock_t input_clock_t;
@@ -94,6 +95,15 @@ void    input_clock_GetSystemOrigin( input_clock_t *, vlc_tick_t *pi_system, vlc
  */
 void    input_clock_ChangeSystemOrigin( input_clock_t *, bool b_absolute, vlc_tick_t i_system );

+/**
+ * Delay the shared clock so that the given stream timestamp reaches its audio
+ * output start date. Recompute the timestamp under the clock lock to account
+ * for concurrent origin changes; paused time is left to ChangePause.
+ * No reference or a timestamp already at/after the start date is a no-op.
+ * May be called from the decoder thread, serialized with decoder flushing.
+ */
+void input_clock_DelayStart( input_clock_t *, vlc_tick_t i_stream, vlc_tick_t i_system );
+
 /**
  * This function converts a pair of timestamp from stream clock to system clock.
  *
diff --git a/src/input/decoder.c b/src/input/decoder.c
index 69488a6..8c20c64 100644
--- a/src/input/decoder.c
+++ b/src/input/decoder.c
@@ -1181,6 +1181,7 @@ static int DecoderPlayAudio( decoder_t *p_dec, block_t *p_audio,
     int i_rate = INPUT_RATE_DEFAULT;

     DecoderWaitUnblock( p_dec );
+    const vlc_tick_t i_stream_pts = p_audio->i_pts + p_owner->i_ts_delay;
     DecoderFixTs( p_dec, &p_audio->i_pts, NULL, &p_audio->i_length,
                   &i_rate, AOUT_MAX_ADVANCE_TIME );
     vlc_mutex_unlock( &p_owner->lock );
@@ -1192,7 +1193,18 @@ static int DecoderPlayAudio( decoder_t *p_dec, block_t *p_audio,
      && i_rate <= INPUT_RATE_DEFAULT*AOUT_MAX_INPUT_RATE
      && !DecoderTimedWait( p_dec, p_audio->i_pts - AOUT_MAX_PREPARE_TIME ) )
     {
-        int status = aout_DecPlay( p_aout, p_audio, i_rate );
+        vlc_tick_t start_date;
+        int status = aout_DecPlay( p_aout, p_audio, i_rate,
+                                  p_owner->p_clock != NULL ? &start_date : NULL );
+        if( p_owner->p_clock != NULL && start_date != VLC_TICK_INVALID )
+        {
+            /* A seek marks the decoder flushing before resetting the clock.
+             * Do not rebase the new timeline from an in-flight old buffer. */
+            vlc_fifo_Lock( p_owner->p_fifo );
+            if( !p_owner->flushing )
+                input_clock_DelayStart( p_owner->p_clock, i_stream_pts, start_date );
+            vlc_fifo_Unlock( p_owner->p_fifo );
+        }
         if( status == AOUT_DEC_CHANGED )
         {
             /* Only reload the decoder */
